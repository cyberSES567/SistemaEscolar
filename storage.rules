rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwnerOrStaff(uid) {
      return signedIn() && (
        request.auth.uid == uid ||
        firestore.exists(/databases/(default)/documents/staff/$(request.auth.token.email.lower()))
      );
    }

    match /submissions/{uid}/{fileName} {
      allow read: if isOwnerOrStaff(uid);
      allow write: if signedIn()
        && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
